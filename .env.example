# Runtime mode: dev or prod
ENV=dev

# Instance identity: dev, rc, production
APP_INSTANCE=dev

# JWT secret
SECRET_KEY=change-me

# Required database URL
# Local SQLite example:
# DATABASE_URL=sqlite:////absolute/path/to/meal-planner.db
#
# PostgreSQL example:
# DATABASE_URL=postgresql://meal_planner_user:password@127.0.0.1:5432/meal_planner
DATABASE_URL=sqlite:////absolute/path/to/meal-planner.db

# Optional safety guard for instance/database pairing
EXPECTED_DATABASE_NAME=meal_planner_dev
PRODUCTION_DATABASE_NAME=fastapi_db

# JWT/session settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
